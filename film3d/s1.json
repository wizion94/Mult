 "captions": [
  {
   "start": 0.0,
   "end": 7.05,
   "text": "It's 9:40 p.m. Sam has been waiting for this all day. One episode. That's the whole *plan*."
  },
  {
   "start": 7.1,
   "end": 11.85,
   "text": "He sits down on the couch. He picks up the remote."
  },
  {
   "start": 11.9,
   "end": 17.35,
   "text": "And from the kitchen, a dirty *mug* starts to feel like an *emergency*."
  },
  {
   "start": 17.4,
   "end": 22.15,
   "text": "Then the unread message. Then the package by the front door."
  },
  {
   "start": 22.2,
   "end": 27.65,
   "text": "If you've ever felt *guilty* for doing absolutely *nothing*, this one's for you."
  },
  {
   "start": 27.7,
   "end": 33.95,
   "text": "By the end, you'll know why it happens, and what to do about it tonight."
  }
 ]
