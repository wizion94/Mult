 "captions": [
  {
   "start": 0.0,
   "end": 5.05,
   "text": "Here's what Sam doesn't notice. Ten minutes ago, none of this mattered."
  },
  {
   "start": 5.1,
   "end": 10.15,
   "text": "The *mug* sat there all afternoon. The message came in at lunch."
  },
  {
   "start": 10.2,
   "end": 14.15,
   "text": "The package has been by the door since Tuesday."
  },
  {
   "start": 14.2,
   "end": 18.45,
   "text": "But the second he sits down, they all get *loud*."
  },
  {
   "start": 18.5,
   "end": 23.25,
   "text": "So he gets up. Just for a second, he tells himself."
  },
